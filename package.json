{
  "name": "stitch-animations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:webhook:single": "SINGLE_ENTRY=webhook vite build",
    "build:reference:single": "SINGLE_ENTRY=reference vite build",
    "build:access:single": "SINGLE_ENTRY=access vite build",
    "dev": "vite",
    "build": "vite build && node scripts/build-embeds.mjs",
    "preview": "vite preview",
    "build:all": "vite build --config vite.config.js && node scripts/build-embeds.mjs",
    "build:hero": "vite build --config vite.config.js --ssrManifest",
    "build:hero:single": "SINGLE_ENTRY=hero vite build",
    "build:api:single": "SINGLE_ENTRY=api vite build",
    "build:chart:single": "SINGLE_ENTRY=chart vite build",
    "build:dots:single": "SINGLE_ENTRY=dots vite build",
    "build:dots-bulge:single": "SINGLE_ENTRY=dots-bulge vite build",
    "build:radial:single": "SINGLE_ENTRY=radial vite build",
    "build:cards:single": "SINGLE_ENTRY=cards vite build",
    "build:deposits:single": "SINGLE_ENTRY=deposits vite build",
    "build:orbit:single": "SINGLE_ENTRY=orbit vite build",
    "build:small-cards:single": "SINGLE_ENTRY=small-cards vite build",
    "build:window-graphic:single": "SINGLE_ENTRY=window-graphic vite build",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  }
}
